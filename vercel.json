{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/nosotros/:path*", "destination": "/pages/nosotros/:path*" },
    { "source": "/asociaciones-y-miembros/:path*", "destination": "/pages/asociaciones-y-miembros/:path*" },
    { "source": "/servicios/:path*", "destination": "/pages/servicios/:path*" },
    { "source": "/proyectos-e-impacto/:path*", "destination": "/pages/proyectos-e-impacto/:path*" },
    { "source": "/gestion-institucional/:path*", "destination": "/pages/gestion-institucional/:path*" },
    { "source": "/noticias-y-comunicados/:path*", "destination": "/pages/noticias-y-comunicados/:path*" },
    { "source": "/contacto", "destination": "/pages/contacto" },
    { "source": "/galeria", "destination": "/pages/galeria" },
    { "source": "/privacidad", "destination": "/pages/privacidad" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pagina-cepse-production.up.railway.app/api/:path*" }
  ],
  "redirects": [
    { "source": "/nosotros", "destination": "/nosotros/quienes-somos", "permanent": true },
    { "source": "/asociaciones-y-miembros", "destination": "/asociaciones-y-miembros/asociaciones-afiliadas", "permanent": true },
    { "source": "/servicios", "destination": "/servicios/areas-productivas/textil", "permanent": true },
    { "source": "/proyectos-e-impacto", "destination": "/proyectos-e-impacto/impacto-social", "permanent": true },
    { "source": "/gestion-institucional", "destination": "/gestion-institucional/gestion-institucional", "permanent": true },
    { "source": "/noticias-y-comunicados", "destination": "/noticias-y-comunicados/noticias", "permanent": true }
  ]
}
