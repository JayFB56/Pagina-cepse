{
  "version": 2,
  "builds": [
    {
      "src": "server-dev.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "pages/**,components/**,css/**,js/**,assets/**,index.html",
        "excludeFiles": "node_modules/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/components/(.*)",
      "dest": "/components/$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/pages/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server-dev.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
